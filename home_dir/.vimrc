"LINE NUMBER options
set number
set relativenumber

"SELLING options
"set spell

"TAB options
set tabstop=4
"To  switch tab to spaces uncomment next 2 lines
set shiftwidth=0
"set expandtab
"Auto indent
"set autoindent
"Use plugin to determine indentation level based on file type
filetype plugin indent on

"LINE WRAP options
set nowrap
